{
 "groups": [
  {
   "title": "Classification",
   "hint": "What the classifier does with what it finds.",
   "items": [
    {
     "label": "Use the acquisition parameters",
     "tip": "Applied: the parameters name the series, with dcm2niix's guess and the series name as second opinions. Shadow: the names stay as before and the classifier only reports what it would do. Off: not run.",
     "default": "To name the series",
     "choices": [
      "To name the series",
      "Only to report",
      "Not at all"
     ],
     "key": "mode"
    },
    {
     "label": "Name without asking above",
     "tip": "A name this sure (0 to 1) is used as it is. Below it, the row is named but marked to check. Range 0.5 to 0.99.",
     "default": "0.8",
     "choices": null,
     "key": "apply_at"
    },
    {
     "label": "Leave to the other opinions below",
     "tip": "Below this, the classifier does not decide: dcm2niix's guess or the series name does, and the row is marked to check. Range 0.1 to 0.9.",
     "default": "0.4",
     "choices": null,
     "key": "check_at"
    }
   ]
  },
  {
   "title": "Weight of the evidence",
   "hint": "How much each kind of evidence counts (1 is as built).",
   "items": [
    {
     "label": "Acquisition parameters",
     "tip": "Echo, repetition and inversion times, flip angle, readout, volumes, diffusion weighting: what the scanner did. Range 0 to 3.",
     "default": "1",
     "choices": null,
     "key": "parameters"
    },
    {
     "label": "Series name",
     "tip": "Words in the series description and protocol name (T1, FLAIR, bold, SBRef, a ReproIn name): what the operator called it. Range 0 to 3.",
     "default": "1",
     "choices": null,
     "key": "names"
    },
    {
     "label": "Neighbouring series",
     "tip": "What the series next to it are: an SBRef before its run, a reversed-phase reference beside a run, the two inversions of an MP2RAGE. Range 0 to 3.",
     "default": "1",
     "choices": null,
     "key": "context"
    }
   ]
  },
  {
   "title": "Anatomical contrasts",
   "hint": "The ranges that tell anatomical contrasts apart.",
   "items": [
    {
     "label": "T1-weighted inversion from",
     "tip": "An inversion-recovery gradient echo (MPRAGE) inverts this long or longer before it reads. Range 0.05 to 2 s.",
     "default": "0.3 s",
     "choices": null,
     "key": "t1_ti_min"
    },
    {
     "label": "T1-weighted inversion up to",
     "tip": "... and no longer than this. Range 0.5 to 3 s.",
     "default": "1.5 s",
     "choices": null,
     "key": "t1_ti_max"
    },
    {
     "label": "FLAIR inversion from",
     "tip": "A spin echo inverting at least this long before it reads nulls the fluid: FLAIR. Range 1 to 4 s.",
     "default": "1.6 s",
     "choices": null,
     "key": "flair_ti_min"
    },
    {
     "label": "T2-weighted echo from",
     "tip": "A spin echo with an echo time this long or longer is T2-weighted. Range 30 to 200 ms.",
     "default": "60 ms",
     "choices": null,
     "key": "t2_te_min"
    },
    {
     "label": "Proton density echo up to",
     "tip": "A spin echo with a short echo time and a long repetition time is proton density weighted. Range 5 to 60 ms.",
     "default": "30 ms",
     "choices": null,
     "key": "pd_te_max"
    },
    {
     "label": "Long repetition time from",
     "tip": "Repetition times this long or longer let the tissue recover (T2 and proton density weighting). Range 1 to 6 s.",
     "default": "2 s",
     "choices": null,
     "key": "long_tr_min"
    },
    {
     "label": "T2*-weighted echo from",
     "tip": "A gradient echo this long or longer (and not an EPI) is T2*-weighted. Range 5 to 60 ms.",
     "default": "15 ms",
     "choices": null,
     "key": "t2star_te_min"
    },
    {
     "label": "MP2RAGE repetition from",
     "tip": "An inversion-recovery 3-D gradient echo repeating this slowly or slower reads two inversions per repetition: an MP2RAGE. Faster, it is an MPRAGE (T1-weighted). Range 2 to 10 s.",
     "default": "3.5 s",
     "choices": null,
     "key": "mp2rage_tr_min"
    },
    {
     "label": "Turbo spin echo from",
     "tip": "A spin echo reading this many echoes per excitation or more (its echo train) is a turbo or fast spin echo, how T2-weighted, PD-weighted and FLAIR images are made. Range 2 to 64 echoes.",
     "default": "2 echoes",
     "choices": null,
     "key": "tse_etl_min"
    },
    {
     "label": "High-resolution 3-D up to",
     "tip": "A 3-D series with voxels this small or smaller in every direction is a structural image (and no localizer). Range 0.3 to 3 mm.",
     "default": "1.3 mm",
     "choices": null,
     "key": "high_res_max_mm"
    }
   ]
  },
  {
   "title": "Gradient-echo contrasts",
   "hint": "The ranges that make a gradient echo T1-weighted, or an angiogram.",
   "items": [
    {
     "label": "3-D spoiled gradient echo, repetition up to",
     "tip": "A 3-D gradient echo repeating this fast or faster, with a small flip angle, is T1-weighted (FLASH, SPGR, a T1 VIBE). Range 5 to 200 ms.",
     "default": "50 ms",
     "choices": null,
     "key": "spoiled_3d_tr_max"
    },
    {
     "label": "3-D spoiled gradient echo, flip angle up to",
     "tip": "... and a flip angle this small or smaller. Range 2 to 90 °.",
     "default": "30 °",
     "choices": null,
     "key": "spoiled_3d_flip_max"
    },
    {
     "label": "2-D spoiled gradient echo, echo up to",
     "tip": "A 2-D gradient echo with an echo this short or shorter, a short repetition and a large flip angle is T1-weighted. Range 1 to 30 ms.",
     "default": "10 ms",
     "choices": null,
     "key": "spoiled_2d_te_max"
    },
    {
     "label": "2-D spoiled gradient echo, repetition up to",
     "tip": "... repeating this fast or faster ... Range 0.05 to 3 s.",
     "default": "1 s",
     "choices": null,
     "key": "spoiled_2d_tr_max"
    },
    {
     "label": "2-D spoiled gradient echo, flip angle from",
     "tip": "... with a flip angle this large or larger. Range 5 to 90 °.",
     "default": "20 °",
     "choices": null,
     "key": "spoiled_2d_flip_min"
    },
    {
     "label": "Magnetization transfer echo up to",
     "tip": "A gradient echo with magnetization transfer and an echo this short or shorter is a T1-weighted MT image, not a T2*-weighted one. Range 2 to 30 ms.",
     "default": "10 ms",
     "choices": null,
     "key": "mt_te_max"
    },
    {
     "label": "Time-of-flight angiography, repetition up to",
     "tip": "A flow-compensated 3-D gradient echo repeating this fast or faster, with a moderate flip angle, is a time-of-flight angiogram: inflowing blood is bright. Range 5 to 150 ms.",
     "default": "50 ms",
     "choices": null,
     "key": "angio_tr_max"
    },
    {
     "label": "Time-of-flight angiography, echo up to",
     "tip": "... with an echo this short ... Range 1 to 20 ms.",
     "default": "10 ms",
     "choices": null,
     "key": "angio_te_max"
    },
    {
     "label": "Time-of-flight angiography, flip angle from",
     "tip": "... a flip angle from ... Range 1 to 60 °.",
     "default": "10 °",
     "choices": null,
     "key": "angio_flip_min"
    },
    {
     "label": "Time-of-flight angiography, flip angle up to",
     "tip": "... up to this. Range 5 to 90 °.",
     "default": "40 °",
     "choices": null,
     "key": "angio_flip_max"
    }
   ]
  },
  {
   "title": "Echoes and fieldmaps",
   "hint": "Echo counts and fieldmaps.",
   "items": [
    {
     "label": "Multi-echo from",
     "tip": "A series read at this many echo times or more is multi-echo (MEGRE, MESE), not one contrast. Two echoes are a fieldmap's or a proton density and T2 pair. Range 2 to 12 echoes.",
     "default": "3 echoes",
     "choices": null,
     "key": "multi_echo_min"
    },
    {
     "label": "Fieldmap first echo up to",
     "tip": "A two-echo gradient echo whose first echo is this short or shorter is a fieldmap's magnitude. Range 2 to 40 ms.",
     "default": "15 ms",
     "choices": null,
     "key": "fieldmap_te_max"
    }
   ]
  },
  {
   "title": "Time series and diffusion",
   "hint": "The counts that tell time series from references and diffusion.",
   "items": [
    {
     "label": "A run has at least",
     "tip": "An EPI series with this many volumes or more is a run (BOLD); fewer is a reference or a test. Range 3 to 100 volumes.",
     "default": "10 volumes",
     "choices": null,
     "key": "run_min_volumes"
    },
    {
     "label": "A reference has at most",
     "tip": "An EPI series with this many volumes or fewer, phase-encoded opposite to a run, is that run's fieldmap. Range 1 to 30 volumes.",
     "default": "9 volumes",
     "choices": null,
     "key": "reference_max_volumes"
    },
    {
     "label": "Diffusion weighting from",
     "tip": "A b-value above this is diffusion weighting. Range 0 to 500 s/mm².",
     "default": "50 s/mm²",
     "choices": null,
     "key": "dwi_min_b"
    },
    {
     "label": "A diffusion series has at least",
     "tip": "Distinct gradient directions in a diffusion series. Range 1 to 30 directions.",
     "default": "3 directions",
     "choices": null,
     "key": "dwi_min_directions"
    },
    {
     "label": "A localizer has at most",
     "tip": "A non-EPI series with this many slices or fewer (in several orientations) is a localizer, left out. Range 1 to 20 slices.",
     "default": "5 slices",
     "choices": null,
     "key": "localizer_max_slices"
    },
    {
     "label": "BOLD echo from",
     "tip": "A gradient-echo EPI time series with an echo this long or longer (and no longer than the next setting) has the T2* weighting of BOLD. Range 5 to 60 ms.",
     "default": "15 ms",
     "choices": null,
     "key": "bold_te_min"
    },
    {
     "label": "BOLD echo up to",
     "tip": "... and no longer than this. Range 20 to 120 ms.",
     "default": "60 ms",
     "choices": null,
     "key": "bold_te_max"
    },
    {
     "label": "A BOLD run repeats at most every",
     "tip": "A time series repeating more slowly than this is unlikely to be BOLD. Range 1 to 20 s.",
     "default": "4 s",
     "choices": null,
     "key": "bold_tr_max"
    },
    {
     "label": "An SBRef precedes its run by at most",
     "tip": "A one-volume EPI is the SBRef of a run with its geometry among the next this many series. Range 1 to 10 series.",
     "default": "3 series",
     "choices": null,
     "key": "sbref_lookahead"
    }
   ]
  },
  {
   "title": "Contrast agent and perfusion",
   "hint": "A contrast agent, and the series made with one or with labelled blood.",
   "items": [
    {
     "label": "Name the contrast agent (ce-)",
     "tip": "A series acquired after a contrast agent was injected carries BIDS's ce- entity: named after the agent in its header (ce-multihance), a fixed label, or not at all.",
     "default": "After the agent in the header",
     "choices": [
      "After the agent in the header",
      "With a fixed label",
      "Not at all"
     ],
     "key": "entity"
    },
    {
     "label": "Fixed label",
     "tip": "The ce- label when the agent is not named, or always when 'With a fixed label' is chosen. Letters and digits only.",
     "default": "gadolinium",
     "choices": null,
     "key": "fixed_label"
    },
    {
     "label": "Also when only the series name says so",
     "tip": "A series named post-contrast (post, +C, Gd, KM, contrast) whose header names no agent gets the ce- entity too, marked to check.",
     "default": "On",
     "choices": null,
     "key": "from_names"
    },
    {
     "label": "A contrast bolus series (DSC perfusion)",
     "tip": "An EPI time series acquired during a contrast bolus measures perfusion (dynamic susceptibility contrast). BIDS 1.11 has no raw suffix for it: leave it out (keep it in sourcedata/), or name it func/cbv, BIDS's contrast-agent blood-volume series.",
     "default": "Leave it out",
     "choices": [
      "Leave it out",
      "Name it func/cbv"
     ],
     "key": "dsc"
    },
    {
     "label": "A bolus series has at least",
     "tip": "An EPI series with a contrast agent and this many volumes or more follows a bolus. Range 3 to 300 volumes.",
     "default": "20 volumes",
     "choices": null,
     "key": "dsc_min_volumes"
    },
    {
     "label": "An ASL M0 reference has at most",
     "tip": "An unlabelled ASL readout with this many volumes or fewer is the M0 reference. Range 1 to 10 volumes.",
     "default": "2 volumes",
     "choices": null,
     "key": "m0_max_volumes"
    }
   ]
  }
 ],
